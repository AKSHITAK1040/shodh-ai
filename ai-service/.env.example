# Shodh-a-Code Environment Configuration Example

# Groq API Configuration (Fast LLM Tool Loop)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini Configuration (Optional Alternative Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Backend & Service Ports
PORT=3000
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AI_URL=http://localhost:3002
JWT_SECRET=super-secret-key-for-takehome
